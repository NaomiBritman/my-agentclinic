# Copy this file to .env, which Git ignores, and fill in the values.

# A long random secret. To create one, run:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# The site only runs on this address.
BETTER_AUTH_URL=http://127.0.0.1:3000

# Optional, for demonstration plans from made-up profiles. Create your own key at
# https://aistudio.google.com/apikey and add it to .env yourself. Never commit it.
GEMINI_API_KEY=
# A Flash model on the free tier.
GEMINI_MODEL=
